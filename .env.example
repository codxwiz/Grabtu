# Core API and database
NODE_ENV="development"
PORT="4000"
DATABASE_URL="postgresql://white_label:white_label@localhost:5432/white_label?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
PAYMENT_CREDENTIALS_SECRET="replace-with-a-different-32-character-secret"
BILLING_WEBHOOK_SECRET="replace-with-at-least-24-random-characters"
TRUST_PROXY="0"
ALLOW_PRODUCTION_SEED="false"

# Public application origins (no trailing slash)
API_ORIGIN="http://localhost:4000"
CUSTOMER_ORIGIN="http://localhost:5173"
DASHBOARD_ORIGIN="http://localhost:5174"
# The extracted product has no separate master-admin frontend. Use the dashboard
# origin in production unless you deploy a dedicated admin application.
MASTER_ADMIN_ORIGIN="http://localhost:5174"
MASTER_ADMIN_PHONE="+919999999999"
DEMO_OWNER_PHONE="+919876543210"

# Firebase Admin (API)
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON for local development only.
GOOGLE_APPLICATION_CREDENTIALS=""

# Firebase Web SDK (restaurant dashboard)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Web push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# Razorpay platform subscription billing. Configure all five values together.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_PLAN_STARTER_ID=""
RAZORPAY_PLAN_GROWTH_ID=""
RAZORPAY_PLAN_BUSINESS_ID=""
# Backward-compatible alias for RAZORPAY_PLAN_BUSINESS_ID.
RAZORPAY_PLAN_PRO_ID=""

# QR image storage. Local storage is suitable for development. Render uses its
# mounted persistent disk; set provider=s3 and fill every S3 value to scale out.
QR_STORAGE_PROVIDER="local"
UPLOAD_DIR="./data/uploads"
QR_STORAGE_LOCAL_DIR="./data/uploads"
QR_STORAGE_PUBLIC_BASE_URL=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Transactional email (console locally; use resend in production if required)
EMAIL_PROVIDER="console"
EMAIL_FROM="Restaurant Platform <no-reply@example.com>"
EMAIL_CAPTURE_PATH="./data/email-outbox.jsonl"
RESEND_API_KEY=""
RESEND_FROM=""

# Optional shared Redis for Socket.IO and rate limiting
REDIS_URL=""

# Web application build-time configuration
VITE_API_ORIGIN="http://localhost:4000"
VITE_CUSTOMER_ORIGIN="http://localhost:5173"
VITE_DASHBOARD_ORIGIN="http://localhost:5174"
VITE_PRODUCT_NAME="Restaurant Platform"
VITE_SUPPORT_EMAIL="support@example.com"
VITE_SALES_URL="http://localhost:5173/contact"
VITE_BRAND_WORDMARK="/brand-wordmark.png"

# Optional monitoring integrations
HEALTH_URL="http://localhost:4000/api/health"
ALERT_WEBHOOK_URL=""
ALERT_SOURCE="white-label"
